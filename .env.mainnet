# 0G Mainnet (Aristotle) Configuration
# ==========================================
# Production environment variables for 0G Mainnet

# 0G Mainnet RPC and Network
OG_CHAIN_RPC_URL=https://evmrpc.0g.ai
OG_RPC_URL=https://evmrpc.0g.ai
OG_CHAIN_ID=16600
OG_NETWORK_NAME=0G-Aristotle-Mainnet

# 0G Mainnet Contract Addresses (Official from docs.0g.ai)
OG_STORAGE_FLOW_CONTRACT=0x62D4144dB0F0a6fBBaeb6296c785C71B3D57C526
OG_STORAGE_MINE_CONTRACT=0xCd01c5Cd953971CE4C2c9bFb95610236a7F414fe
OG_STORAGE_REWARD_CONTRACT=0x457aC76B58ffcDc118AABD6DbC63ff9072880870

# 0G Mainnet Explorers
NEXT_PUBLIC_OG_CHAIN_EXPLORER=https://chainscan.0g.ai
NEXT_PUBLIC_OG_STORAGE_EXPLORER=https://storagescan.0g.ai
OG_CHAIN_EXPLORER=https://chainscan.0g.ai
OG_STORAGE_EXPLORER=https://storagescan.0g.ai

# 0G Mainnet Storage Indexer
OG_INDEXER_RPC=https://indexer-storage-turbo.0g.ai
INDEXER_RPC=https://indexer-storage-turbo.0g.ai

# Private Key (IMPORTANT: Use a dedicated mainnet wallet with real funds)
PRIVATE_KEY=your_mainnet_private_key_here
OG_PRIVATE_KEY=your_mainnet_private_key_here

# Firebase (Same for all environments)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Smart Contract Address (Deploy your auth contract on mainnet first)
NEXT_PUBLIC_AUTH_CONTRACT_ADDRESS=your_mainnet_contract_address

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key

# Security
NEXTAUTH_SECRET=your_nextauth_secret
NODE_ENV=production

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Alternative RPCs (RECOMMENDED for production reliability)
OG_QUICKNODE_RPC=https://your-quicknode-endpoint.0g.quiknode.pro
OG_THIRDWEB_RPC=https://16600.rpc.thirdweb.com
OG_ANKR_RPC=https://rpc.ankr.com/0g
