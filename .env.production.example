# Production Environment Variables for Vercel Deployment

# Firebase Configuration (Required)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# 0G Network Configuration
OG_CHAIN_RPC_URL=https://evmrpc-testnet.0g.ai
OG_API_KEY=your_0g_api_key
OG_CHAIN_ID=16601
OG_NETWORK_NAME=0G-Galileo-Testnet

# 0G Block Explorers
NEXT_PUBLIC_OG_CHAIN_EXPLORER=https://chainscan-galileo.0g.ai
NEXT_PUBLIC_OG_STORAGE_EXPLORER=https://storagescan-galileo.0g.ai

# 0G Storage Configuration
OG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
OG_PRIVATE_KEY=your_private_key_for_storage_operations

# Smart Contract Address
NEXT_PUBLIC_AUTH_CONTRACT_ADDRESS=your_deployed_contract_address

# Gemini AI (Optional)
GEMINI_API_KEY=your_gemini_api_key

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Node Environment
NODE_ENV=production
